# ─────────────────────────────────────────────
# Контент Фабрика — переменные окружения
# Скопируйте этот файл в .env и заполните значения
# ─────────────────────────────────────────────

# PostgreSQL — пароль (используется в docker-compose.yml)
POSTGRES_PASSWORD=replace-with-a-strong-password

# PostgreSQL — строка подключения к базе данных
# При использовании docker-compose: postgresql://app:${POSTGRES_PASSWORD}@db:5432/content_factory
DATABASE_URL=postgresql://user:password@localhost:5432/content_factory

# ProxyAPI — ключ для доступа к GPT-4o и GPT-4o-search-preview
# Получить: https://proxyapi.ru
PROXYAPI_KEY=

# VK — токен доступа (от имени группы, права: wall, photos)
VK_ACCESS_TOKEN=

# VK — ID группы (например: club238494545 или просто 238494545)
VK_GROUP_ID=

# Telegram — токен бота-публикатора (получить у @BotFather)
TELEGRAM_BOT_TOKEN=

# Telegram — ID или username канала (например: @my_channel или -1001234567890)
TELEGRAM_CHANNEL_ID=

# Секрет для подписи сессий Express
SESSION_SECRET=replace-with-a-long-random-string

# ─────────────────────────────────────────────
# Канал «Безопасность всегда» (второй VK-канал)
# ─────────────────────────────────────────────

# VK — ID группы «Безопасность всегда» (например: club12345678 или просто 12345678)
VK2_GROUP_ID=

# VK — токен доступа для «Безопасность всегда»
# Если тот же токен что и для «Я-Инженера» — можно не заполнять (подтянется VK_ACCESS_TOKEN)
VK2_ACCESS_TOKEN=
